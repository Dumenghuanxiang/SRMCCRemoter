<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/debugDialogSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:paddingEnd="8dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/debugFilterGroup"
            android:layout_width="228dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debugFilterAll"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:text="@string/debug_filter_all"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debugFilterTransport"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:text="@string/debug_filter_transport"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debugFilterData"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:text="@string/debug_filter_data"
                android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/debugAutoScroll"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:checked="true"
            android:minHeight="0dp"
            android:text="@string/debug_auto_scroll_compact"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/debugDialogScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="@drawable/terminal_panel_background"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/debugDialogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/terminal_text"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>
